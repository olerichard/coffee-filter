{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=~/.database/coffee-filter.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "Issuer": "coffee-filter.olerichard.no",
    "Audience": "coffee-filter-users",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30,
    "RefreshCookieName": "cf_refresh"
  },
  "Lockout": {
    "MaxFailedAttempts": 5,
    "DurationMinutes": 15
  },
  "Seed": {
    "DemoData": false
  }
}
