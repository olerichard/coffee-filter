{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=~/.database/coffee-filter.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "Issuer": "coffee-filter.olerichard.no",
    "Audience": "coffee-filter-users",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30,
    "RefreshCookieName": "cf_refresh"
  },
  "Lockout": {
    "MaxFailedAttempts": 5,
    "DurationMinutes": 15
  },
  "PasswordReset": {
    "TokenMinutes": 30,
    "FrontendBaseUrl": "http://localhost:3000"
  },
  "Email": {
    "Smtp": {
      "Host": "",
      "Port": 587,
      "Security": "starttls",
      "Username": "",
      "Password": "",
      "FromAddress": "",
      "FromName": "Coffee Filter"
    }
  },
  "Seed": {
    "DemoData": false
  }
}
