# Copy this file to /opt/coffee-filter/.env on the Hetzner server.
# Do not commit the real .env file.

# Used only when the database has no users yet. Change the password after the
# first login; this value does not overwrite an existing account.
Admin__Username=ole
Admin__Password=change-this-before-first-start
Admin__Email=ole@olerichard.no
Admin__DisplayName=Ole

# Required. At least 32 bytes. Generate with: openssl rand -base64 48
JwtSettings__SecretKey=change-this-to-a-long-random-value

# Required for new users to sign up. Leave empty to disable sign-ups.
# Generate with: openssl rand -base64 32
Signup__InviteCode=change-this-to-a-long-random-value

# Optional defaults (15-minute access token, 30-day refresh token inactivity timeout).
# JwtSettings__AccessTokenMinutes=15
# JwtSettings__RefreshTokenDays=30

# Optional lockout defaults (5 failed logins, 15-minute lockout).
# Lockout__MaxFailedAttempts=5
# Lockout__DurationMinutes=15
