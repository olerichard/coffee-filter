{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=/data/coffee-filter.db"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://coffee-filter.olerichard.no"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Authentication": "Warning",
      "Microsoft.IdentityModel": "Warning"
    }
  },
  "JwtSettings": {
    "Issuer": "coffee-filter.olerichard.no",
    "Audience": "coffee-filter-users",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30,
    "RefreshCookieName": "cf_refresh"
  },
  "Lockout": {
    "MaxFailedAttempts": 5,
    "DurationMinutes": 15
  },
  "Seed": {
    "DemoData": false
  }
}
